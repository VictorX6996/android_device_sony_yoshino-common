# priv_app.te

get_prop(priv_app, vendor_semc_version_cust_active_prop)
# 允許所有類型的 App (特別是它們的 RenderThread) 讀取 GPU 狀態
allow { priv_app system_app untrusted_app } sysfs_kgsl:dir search;
allow { priv_app system_app untrusted_app } sysfs_kgsl:file r_file_perms;
allow { priv_app system_app untrusted_app } sysfs_kgsl:lnk_file read;